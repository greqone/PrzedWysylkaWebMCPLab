{
  "name": "przedwysylka-webmcp-lab",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "22.22.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run verify:assets && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:assets": "node scripts/verify-official-assets.mjs",
    "verify:native": "node scripts/verify-native-validity.mjs",
    "verify:scope": "python scripts/verify-cirfmf-tree-census.py --write-report",
    "verify:upstreams": "python scripts/verify-upstream-sources.py --write-report",
    "test:e2e": "playwright test",
    "capture:demo": "npm run build && node scripts/capture-demo.mjs",
    "smoke:native": "npm run build && node scripts/native-webmcp-smoke.mjs"
  },
  "dependencies": {
    "diff": "9.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "xmllint-wasm": "5.3.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.6",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.9.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "saxes": "6.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "webmcp-types": "0.1.5"
  }
}
